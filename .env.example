# Copiá este archivo como .env.local (no se sube a GitHub) y completá los valores.
# Las VITE_* terminan dentro del sitio, así que solo van claves PÚBLICAS por diseño.
# Excepción: el token de depuración de App Check, que es privado y solo se usa con
# npm run dev (no entra en el build de producción). Nunca lo cargues en Vercel.

# EmailJS (email de confirmación de la reserva)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase App Check: clave del sitio de reCAPTCHA Enterprise (Google Cloud → Seguridad → reCAPTCHA)
VITE_RECAPTCHA_SITE_KEY=

# Solo en tu compu (npm run dev): token de prueba registrado en Firebase → App Check → Administrar tokens de depuración
VITE_APPCHECK_DEBUG_TOKEN=
