rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- FUNCIONES AUXILIARES ----------

    // Dueña: siempre administradora (por UID: sigue valiendo aunque cambie email o clave).
    // Tiene que coincidir con DUENA_UID de src/config/admins.js.
    function esDuena() {
      return request.auth != null
        && request.auth.uid == 'OgWsAMKDYgQN8AhgDwjSvIzfjq72';
    }

    // Administradoras: la dueña o quien tenga su documento en /admins (se suman por invitación).
    function esAdmin() {
      return esDuena()
        || (request.auth != null
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Correo de la sesión, en minúsculas.
    function emailSesion() {
      return request.auth.token.email.lower();
    }

    // La invitación existe, es para el correo de la sesión, no venció
    // y se borra en la misma operación (cada link sirve una sola vez).
    function invitacionValida(codigo) {
      let ruta = /databases/$(database)/documents/invitaciones/$(codigo);
      return exists(ruta)
        && get(ruta).data.email == emailSesion()
        && get(ruta).data.expiraEn > request.time
        && !existsAfter(ruta);
    }

    function textoValido(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    function fechaValida(valor) {
      return valor is string && valor.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function horaValida(valor) {
      return valor is string && valor.matches('^[0-9]{2}:[0-9]{2}$');
    }

    // Datos de la clienta dentro de la reserva.
    function clienteValido(c) {
      return c is map
        && c.keys().hasOnly(['nombre', 'apellido', 'telefono', 'email', 'notas'])
        && textoValido(c.nombre, 60)
        && textoValido(c.apellido, 60)
        && textoValido(c.telefono, 30)
        && textoValido(c.email, 120)
        && (!('notas' in c) || (c.notas is string && c.notas.size() <= 500));
    }

    // Estructura exacta que genera finalizarReserva() en TurnoContext.
    function reservaValida(d) {
      return d.keys().hasOnly([
          'sucursalId', 'sucursalNombre', 'servicios', 'asignacionesPorHora',
          'fecha', 'hora', 'formaPago', 'cliente', 'total', 'sena', 'createdAt'
        ])
        && d.keys().hasAll(['sucursalId', 'servicios', 'fecha', 'hora', 'cliente', 'total', 'createdAt'])
        && textoValido(d.sucursalId, 60)
        && fechaValida(d.fecha)
        && horaValida(d.hora)
        && d.servicios is list && d.servicios.size() > 0 && d.servicios.size() <= 20
        && (!('asignacionesPorHora' in d) || d.asignacionesPorHora is map)
        && (!('sucursalNombre' in d) || textoValido(d.sucursalNombre, 80))
        && (!('formaPago' in d) || textoValido(d.formaPago, 60))
        && clienteValido(d.cliente)
        && d.total is number && d.total >= 0
        && (!('sena' in d) || (d.sena is number && d.sena >= 0))
        && d.createdAt is string;
    }

    // Un horario ocupado: solo fecha, hora, sucursal y ocupado = true.
    // El ID tiene que ser fecha_sucursal_hora (ej: 2026-11-21_casanova_1300).
    function horarioValido(slotId, d) {
      return d.keys().hasOnly(['fecha', 'hora', 'sucursalId', 'ocupado'])
        && d.keys().hasAll(['fecha', 'hora', 'sucursalId', 'ocupado'])
        && d.ocupado == true
        && fechaValida(d.fecha)
        && horaValida(d.hora)
        && textoValido(d.sucursalId, 60)
        && slotId == d.fecha + '_' + d.sucursalId + '_' + d.hora.replace(':', '');
    }

    // ---------- COLECCIONES ----------

    // Catálogo: lo ve todo el mundo, lo edita solo la administradora.
    match /servicios/{servicioId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Reservas: datos privados de las clientas.
    // Cualquiera puede CREAR una reserva válida; solo la administradora la ve, edita o borra.
    match /reservas/{reservaId} {
      allow create: if reservaValida(request.resource.data);
      allow read, update, delete: if esAdmin();
    }

    // Disponibilidad: horarios ocupados sin datos personales.
    // Se puede leer para armar el calendario y crear un horario nuevo al reservar.
    // Liberar o modificar un horario: solo la administradora.
    match /disponibilidad/{slotId} {
      allow read: if true;
      allow create: if horarioValido(slotId, request.resource.data);
      allow update, delete: if esAdmin();
    }

    // Configuración pública de la web (por ahora: puntaje y links de reseñas de Google).
    // La lee cualquiera; solo la administradora la cambia.
    match /config/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Opiniones de clientas que se muestran en la web (las carga la administradora).
    match /resenas/{resenaId} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'fecha', 'estrellas', 'texto'])
        && textoValido(request.resource.data.nombre, 60)
        && fechaValida(request.resource.data.fecha)
        && request.resource.data.estrellas is number
        && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 1500;
      allow delete: if esAdmin();
    }

    // Invitaciones para sumar administradoras (/admin → Equipo).
    // El ID es un código secreto de 32 caracteres que va en el link: quien tiene el link puede leerla.
    match /invitaciones/{codigo} {
      allow get: if codigo.matches('^[0-9a-f]{32}$');
      allow list: if esAdmin();
      allow create: if esAdmin()
        && codigo.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['email', 'creadaPor', 'creadaEn', 'expiraEn'])
        && textoValido(request.resource.data.email, 120)
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.expiraEn is timestamp
        && request.resource.data.expiraEn > request.time
        && request.resource.data.expiraEn < request.time + duration.value(31, 'd');
      // La borra una administradora (cancelar) o la persona invitada al usarla.
      allow delete: if esAdmin()
        || (request.auth != null && resource.data.email == emailSesion());
    }

    // Administradoras sumadas por invitación (el ID es su UID).
    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'nombre', 'invitacion', 'creadaEn'])
        && request.resource.data.email == emailSesion()
        && textoValido(request.resource.data.nombre, 60)
        && request.resource.data.invitacion is string
        && invitacionValida(request.resource.data.invitacion);
      allow update: if false;
      allow delete: if esAdmin();
    }

    // Cualquier otra colección queda bloqueada (no hay regla = acceso denegado).
  }
}
